{
	"name": "authwave/php-client",
	"description": "PHP client library to implement Authwave in your application",

	"require": {
		"php": ">=8.1",
		"ext-sodium": "*",
		"phpgt/cipher": "^1.0",
		"phpgt/http": "1.*",
		"phpgt/session": ">=1.1",
		"phpgt/logger": "^1.0"
	},
	"require-dev": {
		"phpunit/phpunit": "^13.2",
		"phpstan/phpstan": "^2.2",
		"squizlabs/php_codesniffer": "^4.0",
		"phpmd/phpmd": "^2.15"
	},
	"autoload": {
		"psr-4": {
			"Authwave\\": "./src"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Authwave\\Test\\": "./test/phpunit"
		}
	},

	"scripts": {
		"phpunit": "vendor/bin/phpunit -c phpunit.xml",
		"phpstan": "vendor/bin/phpstan analyse --memory-limit=512M --level 6 src",
		"phpcs": "vendor/bin/phpcs src --standard=phpcs.xml",
		"phpmd": "vendor/bin/phpmd src/ text phpmd.xml",
		"test": [
			"@phpunit",
			"@phpstan",
			"@phpcs",
			"@phpmd"
		]
	}
}
